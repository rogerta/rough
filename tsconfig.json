{
  "compilerOptions": {
    // "target": "esnext",
    // "module": "nodenext",
    // "moduleResolution": "nodenext",
    "lib": [
      "es2017",
      "dom"
    ],
    "declaration": true,
    "rootDir": "./src/",
    "outDir": "./bin",
    //"baseUrl": ".",
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src/**/*.ts"
  ]
}